# ===== BIGLIGHT 予実管理システム — 環境変数 =====
# `.env` にコピーして値を入れてください。`.env` はコミットしません。

# --- データベース（docker compose の db サービス） ---
# 長いランダム文字列にしてください: openssl rand -hex 24
DB_PASSWORD=changeme

# --- ログイン（Google Identity Services） ---
# CRMと同じ Google Cloud プロジェクトのクライアントIDが使えます。
# 承認済みJavaScript生成元に https://finance.biglight.jp を追加してください。
GOOGLE_CLIENT_ID=904648416175-3dsfs6iji7oki7jdrnks1s7vucj30m7a.apps.googleusercontent.com
ALLOWED_DOMAIN=biglight.jp
# 最初の管理者（カンマ区切りで複数可）。ここに書いた人は必ず Admin・有効になります。
ADMIN_EMAIL=n-tung@biglight.jp

# --- 権限の効かせ方 ---
# enforce = 本当にブロックする（既定） / log = 記録だけして通す（導入直後の様子見用）
PERM_MODE=enforce

# --- CRM連携（任意・後から設定できます） ---
# 設定しない場合は「CSVから取り込む」で運用できます。
# 手順: crm-integration/README.md
CRM_API_BASE=https://api-crm.biglight.jp
CRM_EXPORT_KEY=
